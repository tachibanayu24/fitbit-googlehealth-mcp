# Copy this file to `.env` and fill in your values.
#
#     cp .env.example .env      # macOS / Linux / Git Bash
#     copy .env.example .env    # Windows cmd / PowerShell
#
# `.env` is gitignored and is read ONLY by the local helper scripts
# (`pnpm run setup:google`, `pnpm run probe:google`). The deployed Cloudflare
# Worker never reads this file — it reads Workers Secrets, which you set with
# `wrangler secret put`. See the README section "Where secrets live".
#
# Do not quote the values, and do not leave trailing spaces.

# ---------------------------------------------------------------------------
# Google Cloud OAuth client — Credentials page, application type "Desktop app"
# https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Filled in AFTER you run `pnpm run setup:google`, which prints it.
# Only needed by `pnpm run probe:google`. Access tokens last about an hour, so
# expect to refresh this value if the probe starts returning 401.
# ---------------------------------------------------------------------------
GOOGLE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Legacy Fitbit Web API — only if you set HEALTH_PROVIDER=fitbit.
# Decommissioned by Google in September 2026; leave blank otherwise.
# ---------------------------------------------------------------------------
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
